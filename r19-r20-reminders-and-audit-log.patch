@@ -0,0 +1,61 @@
+const AuditLog = require('../models/AuditLog');
+
+// Names shown to the user in descriptions
+const ENTITY_LABELS = { SplitBill: 'split bill', Reminder: 'bill reminder' };
+const VERBS = { CREATE: 'Created', UPDATE: 'Updated', DELETE: 'Deleted', LOGIN: 'Logged in' };
+
+// Core function: write one audit row.
+// NEVER throws - a problem in the audit log must not break the user's real request.
+// data: { action, entityType, entityId?, description?, changedFields?, transactionId?, user? }
+const logActivity = async (req, data) => {
+  try {
+    const userId = data.user || (req.user && req.user._id);
+    if (!userId) return null;
+    return await AuditLog.create({
+      user: userId,
+      action: data.action,
+      entityType: data.entityType,
+      entityId: data.entityId ? String(data.entityId) : undefined,
+      description: String(data.description || `${VERBS[data.action]} ${data.entityType}`).slice(0, 300),
+      changedFields: data.changedFields || [],
+      transactionId: data.transactionId,
+      ipAddress: req.ip,
+    });
+  } catch (error) {
+    console.error('[audit] could not write audit log:', error.message);
+    return null;
+  }
+};
+
+// Route-level helper, e.g.   router.post('/', audit('CREATE', 'Account'), createAccount)
+// After the controller answers with a 2xx status it automatically logs the action.
+// Entity id  = _id of the JSON response, or :id from the URL.
+// Label      = res.locals.auditLabel (set by the controller) or name/title of the response.
+const audit = (action, entityType) => (req, res, next) => {
+  let responseBody;
+  const originalJson = res.json.bind(res);
+  res.json = (body) => {
+    responseBody = body;
+    return originalJson(body);
+  };
+
+  res.on('finish', () => {
+    if (res.statusCode >= 400) return; // failed requests are not activity
+
+    const body = responseBody && typeof responseBody === 'object' ? responseBody : {};
+    const label = res.locals.auditLabel || body.name || body.title;
+    const entityName = ENTITY_LABELS[entityType] || entityType.toLowerCase();
+
+    logActivity(req, {
+      action,
+      entityType,
+      entityId: body._id || body.id || req.params.id,
+      description: `${VERBS[action]} ${entityName}${label ? ` "${label}"` : ''}`,
+      changedFields: action === 'UPDATE' ? Object.keys(req.body || {}) : [],
+    });
+  });
+
+  next();
+};
+
+module.exports = { logActivity, audit };
diff --git a/backend/models/AuditLog.js b/backend/models/AuditLog.js
index e69de29..9b369aa 100644
--- a/backend/models/AuditLog.js
+++ b/backend/models/AuditLog.js
@@ -0,0 +1,39 @@
+const mongoose = require('mongoose');
+const { AUDIT_ACTIONS, AUDIT_ENTITIES } = require('../config/auditConstants');
+
+// R20: one row = one thing a user did (created / updated / deleted / logged in).
+// Only field NAMES are stored in changedFields - never values (so no passwords, PINs or balances leak).
+const auditLogSchema = new mongoose.Schema(
+  {
+    user: { type: mongoose.Schema.Types.ObjectId, ref: 'User', required: true, index: true },
+    action: { type: String, enum: AUDIT_ACTIONS, required: true },
+    entityType: { type: String, enum: AUDIT_ENTITIES, required: true },
+    entityId: { type: String },
+    description: { type: String, required: true, maxlength: 300 },
+    changedFields: { type: [String], default: [] },
+    transactionId: { type: mongoose.Schema.Types.ObjectId }, // set when the entry belongs to a transaction
+    ipAddress: { type: String },
+    timestamp: { type: Date, default: Date.now },
+  },
+  { versionKey: false }
+);
+
+// fast "my latest activity" queries
+auditLogSchema.index({ user: 1, timestamp: -1 });
+
+// Integrity: an audit log is append-only. Updating or deleting rows is refused.
+const blocked = function () {
+  throw new Error('Audit logs are read-only and cannot be modified or deleted');
+};
+[
+  'updateOne',
+  'updateMany',
+  'findOneAndUpdate',
+  'findOneAndReplace',
+  'replaceOne',
+  'deleteOne',
+  'deleteMany',
+  'findOneAndDelete',
+].forEach((op) => auditLogSchema.pre(op, blocked));
+
+module.exports = mongoose.model('AuditLog', auditLogSchema);
