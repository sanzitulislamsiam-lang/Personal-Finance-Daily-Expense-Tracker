+                      title={b.isActive ? 'Pause' : 'Resume'}
+                      aria-label={`${b.isActive ? 'Pause' : 'Resume'} ${b.title}`}
+                      className="p-2 rounded-lg border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800"
+                    >
+                      {b.isActive ? <Pause className="w-4 h-4" /> : <Play className="w-4 h-4" />}
+                    </button>
+                    <button
+                      onClick={() => window.confirm(`Delete "${b.title}"?`) && runBillAction(() => deleteBill(b._id), 'Bill deleted.')}
