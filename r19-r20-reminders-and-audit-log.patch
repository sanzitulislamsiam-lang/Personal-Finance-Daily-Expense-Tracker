+import React, { useState, useEffect, useCallback } from 'react';
+import { BellRing, Mail, Smartphone, CalendarClock, PencilLine, Send, Loader2, CheckCircle2, AlertCircle, Trash2, Check, Pause, Play, Plus } from 'lucide-react';
+import { useAuth } from '../context/AuthContext';
+import {
+  getReminderSettings,
+  updateReminderSettings,
+  sendTestReminder,
+  getBills,
+  createBill,
+  updateBill,
+  deleteBill,
+  markBillPaid,
+} from '../api/reminderApi';
+
+const cardCls =
+  'bg-white dark:bg-[#121826] p-6 sm:p-8 rounded-3xl border border-slate-200/70 dark:border-slate-800/80 shadow-sm space-y-5';
+const inputCls =
+  'w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-sm text-slate-800 dark:text-slate-100 focus:outline-none focus:ring-2 focus:ring-emerald-500/40';
+const primaryBtn =
+  'inline-flex items-center gap-2 px-5 py-2.5 bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-400 hover:to-teal-400 text-slate-950 font-extrabold rounded-xl text-xs tracking-wider uppercase disabled:opacity-40 transition-all';
+const ghostBtn =
+  'inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-xs font-bold border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 disabled:opacity-40 transition-all';
+
+const Toggle = ({ checked, onChange, label }) => (
+  <button
+    type="button"
+    role="switch"
+    aria-checked={checked}
+    aria-label={label}
+    onClick={() => onChange(!checked)}
+    className={`relative w-11 h-6 rounded-full transition-colors flex-shrink-0 ${checked ? 'bg-emerald-500' : 'bg-slate-300 dark:bg-slate-700'}`}
+  >
+    <span className={`absolute top-0.5 left-0.5 w-5 h-5 rounded-full bg-white transition-transform ${checked ? 'translate-x-5' : ''}`} />
+  </button>
+);
+
+const Row = ({ icon: Icon, title, hint, children }) => (
+  <div className="flex items-start justify-between gap-4 py-3 border-b border-slate-100 dark:border-slate-800 last:border-0">
+    <div className="flex gap-3">
+      <Icon className="w-5 h-5 text-emerald-500 mt-0.5 flex-shrink-0" />
+      <div>
+        <p className="text-sm font-bold text-slate-900 dark:text-white">{title}</p>
+        <p className="text-xs text-slate-500 dark:text-slate-400">{hint}</p>
+      </div>
+    </div>
+    {children}
+  </div>
+);
+
+const dueLabel = (daysLeft) => {
+  if (daysLeft < 0) return { text: `Overdue by ${-daysLeft} day(s)`, cls: 'bg-rose-50 dark:bg-rose-950/50 text-rose-700 dark:text-rose-400 border-rose-200 dark:border-rose-800/60' };
+  if (daysLeft === 0) return { text: 'Due today', cls: 'bg-amber-50 dark:bg-amber-950/40 text-amber-700 dark:text-amber-400 border-amber-200 dark:border-amber-800/60' };
+  return { text: `Due in ${daysLeft} day(s)`, cls: 'bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 border-slate-200 dark:border-slate-700' };
+};
+
+const blankBill = { title: '', amount: '', dueDate: '', repeat: 'none' };
+
+// R19: reminder settings + bill reminders
+export default function Reminders() {
+  const { user } = useAuth();
+  const [settings, setSettings] = useState(null);
+  const [bills, setBills] = useState([]);
+  const [form, setForm] = useState(blankBill);
+  const [busy, setBusy] = useState(false);
+  const [note, setNote] = useState({ type: '', message: '' });
+
+  const say = (type, message) => setNote({ type, message });
+  const errMsg = (err, fallback) => err.response?.data?.message || fallback;
+
+  const load = useCallback(async () => {
+    try {
+      const [s, b] = await Promise.all([getReminderSettings(), getBills()]);
+      setSettings(s);
+      setBills(b);
+    } catch (err) {
+      say('error', errMsg(err, 'Could not load reminders.'));
+    }
+  }, []);
+
+  useEffect(() => {
+    load();
+  }, [load]);
+
+  const set = (key, value) => setSettings((s) => ({ ...s, [key]: value }));
+
+  // asks the browser for permission the first time in-app notifications are switched on
+  const togglePush = async (on) => {
+    set('pushEnabled', on);
+    if (on && typeof Notification !== 'undefined' && Notification.permission === 'default') {
+      try {
+        await Notification.requestPermission();
+      } catch (e) {
+        /* user can still use the bell */
+      }
+    }
+  };
+
+  const saveSettings = async () => {
+    setBusy(true);
+    try {
+      const timezone = Intl.DateTimeFormat().resolvedOptions().timeZone || settings.timezone;
+      const saved = await updateReminderSettings({
+        emailEnabled: settings.emailEnabled,
+        pushEnabled: settings.pushEnabled,
+        dailyLogReminder: settings.dailyLogReminder,
+        dailyLogTime: settings.dailyLogTime,
+        billReminders: settings.billReminders,
+        billNotifyDaysBefore: Number(settings.billNotifyDaysBefore),
+        timezone,
+      });
+      setSettings(saved);
+      say('success', 'Reminder settings saved.');
+    } catch (err) {
+      say('error', errMsg(err, 'Could not save settings.'));
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  const sendTest = async () => {
+    setBusy(true);
+    try {
+      const res = await sendTestReminder();
+      const mail = res.emailStatus === 'sent' ? ' E-mail sent.' : res.emailStatus === 'failed' ? ' E-mail could not be sent (check the SMTP settings).' : '';
+      say(res.emailStatus === 'failed' ? 'error' : 'success', `Test reminder created.${mail}`);
+    } catch (err) {
+      say('error', errMsg(err, 'Could not send test.'));
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  const addBill = async (e) => {
+    e.preventDefault();
+    setBusy(true);
+    try {
+      await createBill({
+        title: form.title,
+        dueDate: form.dueDate,
+        repeat: form.repeat,
+        ...(form.amount !== '' ? { amount: Number(form.amount) } : {}),
+      });
+      setForm(blankBill);
+      say('success', 'Bill reminder added.');
+      setBills(await getBills());
+    } catch (err) {
+      say('error', errMsg(err, 'Could not add the bill.'));
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  const runBillAction = async (action, success) => {
