+    expect((await runReminderCycle({ now: new Date('2026-11-07T12:00:00Z'), sendMail })).daily).toBe(0);
+    expect((await runReminderCycle({ now: new Date('2026-11-07T13:00:00Z'), sendMail })).daily).toBe(1);
