+
+  test('limit is applied; newest first', async () => {
+    const u = await newUser();
+    for (let i = 0; i < 4; i++) await request(app).post('/api/reminders/test').set(auth(u.token));
+    const res = await request(app).get('/api/notifications?limit=2').set(auth(u.token));
+    expect(res.body.notifications).toHaveLength(2);
+    const t = res.body.notifications.map((n) => new Date(n.createdAt).getTime());
+    expect(t[0]).toBeGreaterThanOrEqual(t[1]);
+  });
+
+  test("users cannot see or touch each other's notifications", async () => {
+    const a = await newUser();
+    const b = await newUser();
+    await request(app).post('/api/reminders/test').set(auth(a.token));
+    const aList = await request(app).get('/api/notifications').set(auth(a.token));
+    const id = aList.body.notifications[0]._id;
+
+    expect((await request(app).get('/api/notifications').set(auth(b.token))).body.notifications).toHaveLength(0);
+    expect((await request(app).put(`/api/notifications/${id}/read`).set(auth(b.token))).status).toBe(404);
+    expect((await request(app).put('/api/notifications/garbage/read').set(auth(a.token))).status).toBe(404);
+    await request(app).put('/api/notifications/read-all').set(auth(b.token));
+    expect((await request(app).get('/api/notifications').set(auth(a.token))).body.unreadCount).toBe(1);
+  });
+
+  test('e-mail-only notifications are not shown in the bell', async () => {
+    const u = await newUser();
+    await request(app).put('/api/reminders/settings').set(auth(u.token)).send({ pushEnabled: false, emailEnabled: true });
+    emailService.setTransporter({ sendMail: jest.fn().mockResolvedValue({}) });
+    const test = await request(app).post('/api/reminders/test').set(auth(u.token));
+    expect(test.status).toBe(200);
+    const list = await request(app).get('/api/notifications').set(auth(u.token));
+    expect(list.body.notifications).toHaveLength(0);
+    expect(list.body.unreadCount).toBe(0);
+  });
+
+  test('requires login', async () => {
+    expect((await request(app).get('/api/notifications')).status).toBe(401);
+    expect((await request(app).put('/api/notifications/read-all')).status).toBe(401);
+  });
+});
+
+describe('R19 - "send test reminder" and the e-mail service', () => {
+  test('test reminder reaches the e-mail transport with the right recipient', async () => {
+    const u = await newUser();
+    const sendMail = jest.fn().mockResolvedValue({ messageId: 'ok' });
+    emailService.setTransporter({ sendMail });
+    await request(app).put('/api/reminders/settings').set(auth(u.token)).send({ emailEnabled: true });
+
+    const res = await request(app).post('/api/reminders/test').set(auth(u.token));
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({ inApp: true, emailStatus: 'sent' });
+    expect(sendMail).toHaveBeenCalledTimes(1);
+    expect(sendMail.mock.calls[0][0]).toMatchObject({ to: u.email, subject: 'Test reminder' });
+    expect(sendMail.mock.calls[0][0].from).toContain('no-reply');
