+/**
+ * R19 - Automated Reminders tests
+ *  - notification settings API
+ *  - bill reminders CRUD
+ *  - the scheduler cycle (daily "log your expenses" + bill due) with a fake clock and fake mailer
+ *  - in-app notifications API
+ * Needs a local MongoDB (uses the separate finance_tracker_test database).
+ */
+process.env.JWT_SECRET = 'test_secret';
+process.env.NODE_ENV = 'test';
+delete process.env.SMTP_HOST;
+const mongoose = require('mongoose');
+const request = require('supertest');
+const app = require('../app');
+const User = require('../models/User');
+const Reminder = require('../models/Reminder');
+const Notification = require('../models/Notification');
+const AuditLog = require('../models/AuditLog');
+const emailService = require('../services/emailService');
+const { runReminderCycle, getLocalParts, addMonth, nextOccurrenceOnOrAfter, daysBetween } = require('../services/reminderService');
+
+const TEST_URI = process.env.TEST_MONGO_URI || 'mongodb://127.0.0.1:27017/finance_tracker_test';
+const auth = (token) => ({ Authorization: `Bearer ${token}` });
+let counter = 0;
+
+const newUser = async () => {
+  counter += 1;
+  const res = await request(app)
+    .post('/api/auth/register')
+    .send({ name: `Rem User ${counter}`, email: `rem${counter}@test.com`, password: 'secret123' });
+  expect(res.status).toBe(201);
+  return { token: res.body.token, id: res.body._id, email: res.body.email };
+};
+
+// a user created straight in the DB with the given reminder settings (for scheduler tests)
+const dbUser = async (settings = {}) => {
+  counter += 1;
+  return User.create({
+    name: `Cron User ${counter}`,
+    email: `cron${counter}@test.com`,
+    password: 'secret123',
+    reminderSettings: settings,
+  });
+};
+
+const bill = (user, fields = {}) =>
+  Reminder.create({
+    user: user._id,
+    title: 'Internet',
+    amount: 1200,
+    dueDate: '2026-11-10',
+    dueDay: 10,
+    repeat: 'none',
+    ...fields,
+  });
+
+const mailer = () => jest.fn().mockResolvedValue({ messageId: 'x' });
+const notes = (user) => Notification.find({ user: user._id }).sort({ createdAt: 1 });
+const addDays = (dateStr, n) => new Date(Date.parse(`${dateStr}T00:00:00Z`) + n * 86400000).toISOString().slice(0, 10);
+
+// Dhaka is UTC+6 (no daylight saving)
+const dhaka = (date, hhmm) => new Date(`${date}T${hhmm}:00+06:00`);
+
+beforeAll(async () => {
+  await mongoose.connect(TEST_URI);
+  await mongoose.connection.dropDatabase();
+  await Notification.init(); // builds the unique (user, dedupeKey) index
+  await AuditLog.init();
+});
+
+afterEach(() => emailService.setTransporter(null));
+
+afterAll(async () => {
+  await mongoose.connection.dropDatabase();
+  await mongoose.disconnect();
+});
