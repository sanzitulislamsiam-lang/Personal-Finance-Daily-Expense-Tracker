+describe('R19 - date helpers', () => {
+  test('addMonth keeps the original day (31st -> 28th -> 31st) without drifting', () => {
+    expect(addMonth('2026-01-31', 31)).toBe('2026-02-28');
+    expect(addMonth('2026-02-28', 31)).toBe('2026-03-31');
+    expect(addMonth('2028-01-31', 31)).toBe('2028-02-29'); // leap year
+    expect(addMonth('2026-12-15', 15)).toBe('2027-01-15');
+  });
+
+  test('nextOccurrenceOnOrAfter', () => {
+    expect(nextOccurrenceOnOrAfter(10, '2026-11-07')).toBe('2026-11-10');
+    expect(nextOccurrenceOnOrAfter(5, '2026-11-07')).toBe('2026-12-05');
+    expect(nextOccurrenceOnOrAfter(31, '2026-11-07')).toBe('2026-11-30');
+    expect(nextOccurrenceOnOrAfter(7, '2026-11-07')).toBe('2026-11-07');
+  });
+
+  test('daysBetween and local time in a time zone', () => {
+    expect(daysBetween('2026-11-07', '2026-11-10')).toBe(3);
+    expect(daysBetween('2026-11-10', '2026-11-07')).toBe(-3);
+    expect(getLocalParts(new Date('2026-11-07T14:00:00Z'), 'Asia/Dhaka')).toEqual({ date: '2026-11-07', minutes: 20 * 60 });
+    expect(getLocalParts(new Date('2026-11-07T20:30:00Z'), 'Asia/Dhaka')).toEqual({ date: '2026-11-08', minutes: 150 });
+  });
+});
