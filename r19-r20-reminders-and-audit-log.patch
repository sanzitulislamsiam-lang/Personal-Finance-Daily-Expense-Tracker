+  });
+  const settings = { emailEnabled: true, pushEnabled: true, dailyLogReminder: true, dailyLogTime: '20:00', timezone: 'Asia/Dhaka' };
+
+  test('fires at the chosen local time, sends e-mail + in-app notification', async () => {
+    const user = await dbUser(settings);
+    const sendMail = mailer();
+    const r = await runReminderCycle({ now: dhaka('2026-11-07', '20:00'), sendMail });
+    expect(r.daily).toBe(1);
+    expect(sendMail).toHaveBeenCalledTimes(1);
+    expect(sendMail.mock.calls[0][0]).toMatchObject({ to: user.email, subject: 'Time to log your expenses' });
+
+    const [n] = await notes(user);
+    expect(n).toMatchObject({ type: 'daily_log', inApp: true, isRead: false, emailStatus: 'sent' });
+  });
+
+  test('is not sent twice for the same day (dedupe), but is sent again the next day', async () => {
+    const user = await dbUser(settings);
+    const sendMail = mailer();
+    await runReminderCycle({ now: dhaka('2026-11-07', '20:00'), sendMail });
+    await runReminderCycle({ now: dhaka('2026-11-07', '20:00'), sendMail });
+    await runReminderCycle({ now: dhaka('2026-11-07', '20:03'), sendMail });
+    expect(await Notification.countDocuments({ user: user._id })).toBe(1);
+    expect(sendMail).toHaveBeenCalledTimes(1);
+
+    await runReminderCycle({ now: dhaka('2026-11-08', '20:00'), sendMail });
+    expect(await Notification.countDocuments({ user: user._id })).toBe(2);
+  });
+
+  test('only inside the time window (not before, not 5+ minutes late)', async () => {
+    const user = await dbUser(settings);
+    const sendMail = mailer();
+    expect((await runReminderCycle({ now: dhaka('2026-11-07', '19:59'), sendMail })).daily).toBe(0);
+    expect((await runReminderCycle({ now: dhaka('2026-11-07', '20:05'), sendMail })).daily).toBe(0);
+    expect((await runReminderCycle({ now: dhaka('2026-11-07', '23:00'), sendMail })).daily).toBe(0);
+    expect(await Notification.countDocuments({ user: user._id })).toBe(0);
+    expect((await runReminderCycle({ now: dhaka('2026-11-07', '20:04'), sendMail })).daily).toBe(1);
